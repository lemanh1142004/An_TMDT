# ==============================================================================
# FASHION STORE - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust values as needed.
# DO NOT commit .env into source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=fashion_store_db
POSTGRES_USER=fashion_user
POSTGRES_PASSWORD=fashion_secret_password

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=fashion_store_db
DATABASE_USERNAME=fashion_user
DATABASE_PASSWORD=fashion_secret_password

# ------------------------------------------------------------------------------
# 2. Redis (Cache & Session)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 3. Backend Service (Spring Boot 3)
# ------------------------------------------------------------------------------
BACKEND_PORT=8080
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# Google OAuth2 (Placeholders for future roadmap)
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ------------------------------------------------------------------------------
# 4. Gateway Service (Spring Cloud Gateway)
# ------------------------------------------------------------------------------
GATEWAY_PORT=8081
BACKEND_SERVICE_URL=http://localhost:8080

# ------------------------------------------------------------------------------
# 5. Frontend Client (React + Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8081
